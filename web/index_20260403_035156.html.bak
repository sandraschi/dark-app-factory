<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dark App Factory Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root { --glass: rgba(255,255,255,.05); --border: rgba(255,255,255,.1); --acc: #6366f1; }
        body { font-family: Outfit, sans-serif; background: radial-gradient(circle at top right, #1e1b4b, #0f172a, #020617); color: #e2e8f0; }
        .glass { background: var(--glass); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid var(--border); }
        .sidebar-item:hover { background: rgba(255,255,255,.08); }
    </style>
</head>
<body class="flex min-h-screen">
    <aside class="w-64 glass p-6 fixed left-0 top-0 h-screen">
        <h1 class="text-xl font-bold mb-8">Dark App Factory</h1>
        <nav class="space-y-2">
            <a href="#" id="nav-dashboard" class="sidebar-item block p-3 rounded bg-white/10" onclick="showSection('dashboard')">Dashboard</a>
            <a href="#" id="nav-build" class="sidebar-item block p-3 rounded" onclick="showSection('build')">Build Runner</a>
            <a href="#" id="nav-specialists" class="sidebar-item block p-3 rounded" onclick="showSection('specialists')">Specialists</a>
            <a href="#" id="nav-settings" class="sidebar-item block p-3 rounded" onclick="showSection('settings')">Settings</a>
            <a href="#" id="nav-help" class="sidebar-item block p-3 rounded" onclick="showSection('help')">Help</a>
            <a href="#" id="nav-log" class="sidebar-item block p-3 rounded" onclick="showSection('log')">Logs</a>
        </nav>
    </aside>

    <main class="ml-64 p-8 w-full">
        <header class="glass rounded-xl p-4 flex justify-between items-center mb-6">
            <div class="text-sm text-slate-300">Project: <span id="project-name" class="font-semibold text-indigo-300">dark-app-factory</span></div>
            <div class="text-xs text-slate-400">Dashboard + Build control</div>
        </header>

        <section id="section-dashboard" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="glass rounded-xl p-4">
                    <p class="text-xs text-slate-400">Active builds</p>
                    <p id="active-builds" class="text-3xl font-bold">0</p>
                </div>
                <div class="glass rounded-xl p-4">
                    <p class="text-xs text-slate-400">Last verdict</p>
                    <p id="system-verdict" class="text-xl font-semibold">No runs yet</p>
                </div>
                <div class="glass rounded-xl p-4">
                    <p class="text-xs text-slate-400">Provider</p>
                    <p id="provider-pill" class="text-xl font-semibold">ollama</p>
                </div>
            </div>
            <div class="glass rounded-xl p-6">
                <h2 class="text-xl font-bold mb-2">Quick actions</h2>
                <div class="flex gap-3">
                    <button class="bg-indigo-600 px-4 py-2 rounded" onclick="showSection('build')">Start build</button>
                    <button class="bg-slate-700 px-4 py-2 rounded" onclick="showSection('settings')">Edit model settings</button>
                    <button class="bg-slate-700 px-4 py-2 rounded" onclick="showSection('log')">Open logs</button>
                </div>
            </div>
        </section>

        <section id="section-build" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 space-y-6">
                <div class="glass rounded-xl p-6">
                    <h2 class="text-xl font-bold mb-4">Build runner</h2>
                    <label class="text-xs text-slate-400 block mb-2">Sample prompts</label>
                    <select id="sample-prompts" title="Select a sample prompt" onchange="applySamplePrompt()" class="w-full bg-black/40 rounded p-2 mb-4 border border-white/10">
                        <option value="" disabled selected>Select a sample prompt</option>
                        <option value="Build a FastAPI CRM for a small services business with auth, contacts, and invoices.">CRM (FastAPI)</option>
                        <option value="Build an Express + React inventory dashboard with role-based login and audit logs.">Inventory dashboard (Express + React)</option>
                        <option value="Build a documentation portal with search, markdown rendering, and admin publishing workflow.">Documentation portal</option>
                    </select>

                    <textarea id="vibe-input" title="Vibe input" oninput="checkRefinementVisibility()" class="w-full h-40 rounded p-4 bg-black/40 border border-white/10" placeholder="Describe what to build..."></textarea>

                    <div id="refinement-container" class="hidden mt-4 glass rounded-xl p-4">
                        <p class="text-sm font-semibold mb-2">Prompt refinement</p>
                        <div id="improved-prompt-area" class="hidden text-sm bg-black/40 p-3 rounded mb-3 border border-white/10"></div>
                        <div class="flex gap-2">
                            <button id="refine-btn" onclick="refinePrompt()" class="bg-indigo-600/30 border border-indigo-400/40 rounded px-3 py-2 text-sm">Refine prompt</button>
                            <button id="refine-accept-btn" onclick="useRefinedPrompt()" class="hidden bg-emerald-600/30 border border-emerald-400/40 rounded px-3 py-2 text-sm">Use refined</button>
                            <button onclick="dismissRefinement()" class="bg-white/10 rounded px-3 py-2 text-sm">Dismiss</button>
                        </div>
                    </div>

                    <div class="mt-6 pt-4 border-t border-white/10">
                        <h3 class="font-semibold mb-3">Ghost extraction (optional)</h3>
                        <div class="flex gap-2 mb-3">
                            <input id="ghostSearchQuery" title="Ghost search query" class="flex-1 bg-black/40 rounded p-2 border border-white/10" placeholder="Search exemplar websites">
                            <button onclick="suggestExemplars()" class="bg-slate-700 rounded px-3">Suggest</button>
                        </div>
                        <div id="exemplarContainer" class="hidden mb-3">
                            <div id="exemplarList" class="space-y-2"></div>
                        </div>
                        <div class="flex gap-2">
                            <input id="ghostUrl" title="Ghost URL" class="flex-1 bg-black/40 rounded p-2 border border-white/10" placeholder="https://example.com">
                            <button onclick="extractGhost()" class="bg-slate-700 rounded px-3">Extract</button>
                        </div>
                        <div id="ghostStatus" class="hidden mt-3 bg-black/30 p-3 rounded border border-white/10">
                            <p id="ghostSummary" class="text-sm mb-2"></p>
                            <pre id="ghostBlueprint" class="text-xs whitespace-pre-wrap"></pre>
                        </div>
                    </div>

                    <div class="mt-6 flex justify-end">
                        <button id="build-btn" onclick="triggerBuild()" class="bg-indigo-600 px-6 py-2 rounded font-semibold">Start build</button>
                    </div>

                    <div id="progress-container" class="hidden mt-4">
                        <div class="flex justify-between text-sm mb-1">
                            <span id="progress-status">Running</span>
                            <span id="progress-percentage">0%</span>
                        </div>
                        <p id="progress-detail" class="text-xs text-slate-500 mb-2">Build in progress</p>
                        <div class="w-full h-2 bg-black/40 rounded overflow-hidden border border-white/10">
                            <div id="progress-bar" class="h-full bg-indigo-600 w-0"></div>
                        </div>
                    </div>
                </div>

                <div class="glass rounded-xl p-6">
                    <h3 class="font-semibold mb-3">Live build logs</h3>
                    <div id="logs" class="bg-black/40 rounded p-3 h-56 overflow-y-auto font-mono text-xs space-y-1">
                        <p class="text-slate-500">> dashboard initialized</p>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <div class="glass rounded-xl p-4">
                    <p class="text-xs text-slate-400">Build status</p>
                    <p id="build-status-text" class="text-lg font-semibold">Ready</p>
                </div>
                <div class="glass rounded-xl p-4">
                    <p class="text-xs text-slate-400 mb-2">Current settings</p>
                    <div class="text-sm space-y-1">
                        <p><span class="text-slate-400">Provider:</span> <span id="summary-provider">ollama</span></p>
                        <p><span class="text-slate-400">Foreman:</span> <span id="summary-foreman">llama3.1:latest</span></p>
                        <p><span class="text-slate-400">Worker:</span> <span id="summary-worker">qwen2.5-coder:latest</span></p>
                    </div>
                </div>
            </div>
        </section>

        <section id="section-specialists" class="hidden">
            <div class="glass rounded-xl p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-bold">Specialists</h2>
                    <button onclick="fetchSpecialists()" class="bg-slate-700 rounded px-3 py-2 text-sm">Refresh</button>
                </div>
                <div id="specialist-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
            </div>
        </section>

        <section id="section-settings" class="hidden">
            <div class="glass rounded-xl p-6 max-w-3xl">
                <h2 class="text-xl font-bold mb-4">Model and provider settings</h2>
                <form id="settings-form" class="space-y-4" onsubmit="saveSettings(event)">
                    <div>
                        <label class="text-xs text-slate-400 block mb-1">Provider</label>
                        <select id="settings-provider" title="Select LLM provider" class="w-full bg-black/40 rounded p-2 border border-white/10">
                            <option value="ollama">Ollama</option>
                            <option value="lmstudio">LM Studio</option>
                            <option value="glom">Glom</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 block mb-1">Base URL</label>
                        <input id="settings-base-url" title="API Base URL" placeholder="http://localhost:11434" class="w-full bg-black/40 rounded p-2 border border-white/10">
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="relative">
                            <label class="text-xs text-slate-400 block mb-1">Foreman model</label>
                            <div class="flex gap-1">
                                <input id="settings-foreman-model" title="Foreman model name" list="model-list" class="flex-1 bg-black/40 rounded p-2 border border-white/10" placeholder="e.g. llama3.1">
                                <button type="button" onclick="loadModels()" class="bg-indigo-600/30 border border-indigo-400/40 rounded px-2" title="Scan local models">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                                </button>
                            </div>
                        </div>
                        <div class="relative">
                            <label class="text-xs text-slate-400 block mb-1">Worker model</label>
                            <div class="flex gap-1">
                                <input id="settings-worker-model" title="Worker model name" list="model-list" class="flex-1 bg-black/40 rounded p-2 border border-white/10" placeholder="e.g. qwen2.5-coder">
                                <button type="button" onclick="loadModels()" class="bg-indigo-600/30 border border-indigo-400/40 rounded px-2" title="Scan local models">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                                </button>
                            </div>
                        </div>
                        <datalist id="model-list"></datalist>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="text-xs text-slate-400 block mb-1">Context length</label>
                            <input id="settings-context-length" title="Context length" type="number" placeholder="8192" class="w-full bg-black/40 rounded p-2 border border-white/10">
                        </div>
                        <div>
                            <label class="text-xs text-slate-400 block mb-1">Timeout seconds</label>
                            <input id="settings-timeout-seconds" title="Timeout seconds" type="number" placeholder="120" class="w-full bg-black/40 rounded p-2 border border-white/10">
                        </div>
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 block mb-1">API key (optional)</label>
                        <input id="settings-api-key" title="Provider API key" placeholder="Optional" class="w-full bg-black/40 rounded p-2 border border-white/10">
                    </div>
                    <button class="bg-indigo-600 px-4 py-2 rounded" type="submit">Save settings</button>
                </form>
            </div>
        </section>

        <section id="section-help" class="hidden">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                <div class="glass rounded-xl p-4">
                    <h2 class="font-semibold mb-3">Help documents</h2>
                    <div id="help-doc-list" class="space-y-2 text-sm"></div>
                </div>
                <div class="glass rounded-xl p-4 lg:col-span-2">
                    <h3 id="help-doc-title" class="font-semibold mb-3">Select a document</h3>
                    <pre id="help-doc-content" class="text-xs whitespace-pre-wrap bg-black/40 rounded p-3 max-h-[560px] overflow-y-auto"></pre>
                </div>
            </div>
        </section>

        <section id="section-log" class="hidden">
            <div class="glass rounded-xl p-6">
                <div class="flex gap-2 mb-4">
                    <input id="log-search" title="Search logs" class="flex-1 bg-black/40 rounded p-2 border border-white/10" placeholder="Search log text">
                    <input id="log-lines" title="Number of lines" class="w-32 bg-black/40 rounded p-2 border border-white/10" value="200" placeholder="200">
                    <button onclick="loadLogPage()" class="bg-slate-700 rounded px-3">Refresh</button>
                    <a href="/api/logs/download" class="bg-indigo-600 rounded px-3 py-2 text-sm">Download</a>
                </div>
                <pre id="log-content" class="text-xs whitespace-pre-wrap bg-black/40 rounded p-3 max-h-[620px] overflow-y-auto"></pre>
            </div>
        </section>
    </main>

    <div id="docs-modal" class="hidden fixed inset-0 bg-black/70 z-50 p-8">
        <div class="glass rounded-xl p-4 max-w-3xl mx-auto">
            <div class="flex justify-between items-center mb-2">
                <h3 id="modal-title" class="font-semibold">Specialist docs</h3>
                <button onclick="hideDocs()">Close</button>
            </div>
            <pre id="modal-content" class="text-xs whitespace-pre-wrap max-h-[70vh] overflow-y-auto bg-black/40 rounded p-3"></pre>
        </div>
    </div>

    <script>
        const API_BASE = "/api";
        let refinementHistory = [];
        let currentImprovedText = "";
        window.lastProgress = 0;

        function appendLog(msg, colorClass = "") {
            const logs = document.getElementById("logs");
            const p = document.createElement("p");
            p.className = colorClass;
            p.innerText = `> [${new Date().toLocaleTimeString()}] ${msg}`;
            logs.appendChild(p);
            logs.scrollTop = logs.scrollHeight;
        }

        function setActiveNav(sectionId) {
            document.querySelectorAll(".sidebar-item").forEach((el) => el.classList.remove("bg-white/10"));
            const nav = document.getElementById(`nav-${sectionId}`);
            if (nav) nav.classList.add("bg-white/10");
        }

        function showSection(sectionId) {
            document.querySelectorAll("main section").forEach((s) => s.classList.add("hidden"));
            document.getElementById(`section-${sectionId}`).classList.remove("hidden");
            setActiveNav(sectionId);
            if (sectionId === "specialists") fetchSpecialists();
            if (sectionId === "settings") {
                loadSettings();
                loadModels();
            }
            if (sectionId === "help") loadHelpIndex();
            if (sectionId === "log") loadLogPage();
        }

        async function loadModels() {
            const list = document.getElementById("model-list");
            list.innerHTML = "";
            appendLog("Scanning for local models...", "text-slate-400");
            try {
                const res = await fetch(`${API_BASE}/models`);
                const data = await res.json();
                if (data.success && data.models.length > 0) {
                    data.models.forEach(m => {
                        const opt = document.createElement("option");
                        opt.value = m.id;
                        opt.innerText = `${m.id} (${m.provider})`;
                        list.appendChild(opt);
                    });
                    appendLog(`Discovered ${data.models.length} models.`, "text-emerald-300");
                } else {
                    appendLog("No local models found. Ensure Ollama (11434) or LM Studio (1234) is running.", "text-amber-400");
                }
            } catch (error) {
                appendLog(`Model discovery failed: ${error.message}`, "text-rose-400");
            }
        }

        function applySamplePrompt() {
            const select = document.getElementById("sample-prompts");
            const input = document.getElementById("vibe-input");
            if (select.value) {
                input.value = select.value;
                checkRefinementVisibility();
                appendLog(`Applied sample prompt: ${select.options[select.selectedIndex].text}`, "text-indigo-300");
            }
        }

        function checkRefinementVisibility() {
            const vibe = document.getElementById("vibe-input").value.trim();
            const container = document.getElementById("refinement-container");
            if (vibe.length > 10) container.classList.remove("hidden");
        }

        function dismissRefinement() {
            document.getElementById("refinement-container").classList.add("hidden");
            document.getElementById("improved-prompt-area").classList.add("hidden");
        }

        async function refinePrompt() {
            const vibe = document.getElementById("vibe-input").value.trim();
            if (!vibe) return;
            const refineBtn = document.getElementById("refine-btn");
            refineBtn.disabled = true;
            refineBtn.innerText = "Refining...";
            try {
                const res = await fetch(`${API_BASE}/refine`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ prompt: vibe, history: refinementHistory })
                });
                const data = await res.json();
                currentImprovedText = data.improved || "";
                const area = document.getElementById("improved-prompt-area");
                area.innerHTML = currentImprovedText.replace(/\n/g, "<br>");
                area.classList.remove("hidden");
                document.getElementById("refine-accept-btn").classList.remove("hidden");
                appendLog("Prompt refinement completed.", "text-emerald-300");
            } catch (error) {
                appendLog(`Refinement failed: ${error.message}`, "text-rose-400");
            } finally {
                refineBtn.disabled = false;
                refineBtn.innerText = "Refine prompt";
            }
        }

        function useRefinedPrompt() {
            const input = document.getElementById("vibe-input");
            refinementHistory.push(input.value);
            input.value = currentImprovedText;
            dismissRefinement();
            appendLog("Refined prompt applied.", "text-emerald-300");
        }

        async function triggerBuild() {
            const vibe = document.getElementById("vibe-input").value.trim();
            if (!vibe) {
                alert("Enter a build prompt first.");
                return;
            }
            appendLog("Build requested.", "text-indigo-300");
            try {
                const res = await fetch(`${API_BASE}/build`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        vibe_content: vibe,
                        ghost_blueprint_path: window.ghostBlueprintPath || null
                    })
                });
                const data = await res.json();
                if (res.ok) {
                    appendLog(data.message || "Build launched.", "text-emerald-300");
                    document.getElementById("vibe-input").value = "";
                    window.ghostBlueprintPath = null;
                } else {
                    appendLog(data.detail || "Build failed to start.", "text-rose-400");
                }
            } catch (error) {
                appendLog(`Build request failed: ${error.message}`, "text-rose-400");
            }
        }

        async function updateStatus() {
            try {
                const res = await fetch(`${API_BASE}/status`);
                const data = await res.json();
                document.getElementById("active-builds").innerText = String(data.active_builds ?? 0);
                document.getElementById("system-verdict").innerText = data.last_verdict || "No runs yet";
                document.getElementById("provider-pill").innerText = data.settings_provider || "ollama";
                document.getElementById("build-status-text").innerText = (data.active_builds ?? 0) > 0 ? "Running" : "Ready";

                const buildBtn = document.getElementById("build-btn");
                if ((data.active_builds ?? 0) > 0) {
                    buildBtn.disabled = true;
                    buildBtn.classList.add("opacity-50", "cursor-not-allowed");
                    document.getElementById("progress-container").classList.remove("hidden");
                    await pollProgress();
                } else {
                    buildBtn.disabled = false;
                    buildBtn.classList.remove("opacity-50", "cursor-not-allowed");
                    if (window.lastProgress === 100) {
                        setTimeout(() => {
                            document.getElementById("progress-container").classList.add("hidden");
                        }, 2000);
                    }
                }
            } catch (error) {
                console.error(error);
            }
        }

        async function pollProgress() {
            try {
                const res = await fetch(`${API_BASE}/progress`);
                const data = await res.json();
                const pct = Number(data.percentage || 0);
                document.getElementById("progress-bar").style.width = `${pct}%`;
                document.getElementById("progress-percentage").innerText = `${pct}%`;
                document.getElementById("progress-status").innerText = data.status || "Running";
                document.getElementById("progress-detail").innerText = data.detail || "Build in progress";
                window.lastProgress = pct;
            } catch (error) {
                console.error(error);
            }
        }

        async function fetchSpecialists() {
            const grid = document.getElementById("specialist-grid");
            grid.innerHTML = "";
            try {
                const res = await fetch(`${API_BASE}/specialists`);
                const data = await res.json();
                if (!data.success) throw new Error(data.detail || "Failed to load specialists.");
                for (const spec of data.specialists) {
                    const card = document.createElement("div");
                    card.className = "glass rounded-xl p-4";
                    card.innerHTML = `
                        <h3 class="font-semibold mb-1">${spec.name}</h3>
                        <p class="text-xs text-slate-400 mb-2">Temp: ${spec.temperature}</p>
                        <p class="text-xs text-slate-400 mb-2">Requires: ${spec.requires.join(", ") || "None"}</p>
                        <p class="text-xs text-slate-500 mb-3">Owns: ${spec.owned_patterns.join(", ")}</p>
                        <button class="text-xs bg-white/10 rounded px-2 py-1" onclick="showDocs('${spec.name}', \`${(spec.docs || "").replace(/`/g, "\\`").replace(/\$/g, "\\$")}\`)">View docs</button>
                    `;
                    grid.appendChild(card);
                }
            } catch (error) {
                grid.innerHTML = `<p class="text-rose-400 text-sm">${error.message}</p>`;
            }
        }

        function showDocs(name, docs) {
            document.getElementById("modal-title").innerText = `${name} docs`;
            document.getElementById("modal-content").innerText = (docs || "").trim();
            document.getElementById("docs-modal").classList.remove("hidden");
        }

        function hideDocs() {
            document.getElementById("docs-modal").classList.add("hidden");
        }

        async function loadSettings() {
            const res = await fetch(`${API_BASE}/settings`);
            const data = await res.json();
            if (!data.success) return;
            const s = data.settings;
            document.getElementById("settings-provider").value = s.provider;
            document.getElementById("settings-base-url").value = s.base_url;
            document.getElementById("settings-foreman-model").value = s.foreman_model;
            document.getElementById("settings-worker-model").value = s.worker_model;
            document.getElementById("settings-context-length").value = s.context_length;
            document.getElementById("settings-timeout-seconds").value = s.timeout_seconds;
            document.getElementById("settings-api-key").value = s.api_key;
            document.getElementById("summary-provider").innerText = s.provider;
            document.getElementById("summary-foreman").innerText = s.foreman_model;
            document.getElementById("summary-worker").innerText = s.worker_model;
        }

        async function saveSettings(event) {
            event.preventDefault();
            const payload = {
                provider: document.getElementById("settings-provider").value,
                base_url: document.getElementById("settings-base-url").value,
                foreman_model: document.getElementById("settings-foreman-model").value,
                worker_model: document.getElementById("settings-worker-model").value,
                context_length: Number(document.getElementById("settings-context-length").value),
                timeout_seconds: Number(document.getElementById("settings-timeout-seconds").value),
                api_key: document.getElementById("settings-api-key").value || "ollama"
            };
            const res = await fetch(`${API_BASE}/settings`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                appendLog("Settings saved.", "text-emerald-300");
                await loadSettings();
                await updateStatus();
            } else {
                appendLog("Failed to save settings.", "text-rose-400");
            }
        }

        async function loadHelpIndex() {
            const list = document.getElementById("help-doc-list");
            list.innerHTML = "";
            const res = await fetch(`${API_BASE}/help`);
            const data = await res.json();
            if (!data.success) return;
            data.docs.forEach((doc) => {
                const button = document.createElement("button");
                button.className = "w-full text-left text-xs bg-white/5 hover:bg-white/10 rounded px-3 py-2";
                button.innerText = doc.title;
                button.onclick = () => loadHelpDoc(doc.id, doc.title);
                list.appendChild(button);
            });
        }

        async function loadHelpDoc(docId, title) {
            const res = await fetch(`${API_BASE}/help/${docId}`);
            const data = await res.json();
            if (!data.success) return;
            document.getElementById("help-doc-title").innerText = title;
            document.getElementById("help-doc-content").innerText = data.content;
        }

        async function loadLogPage() {
            const lines = Number(document.getElementById("log-lines").value || 200);
            const search = document.getElementById("log-search").value || "";
            const res = await fetch(`${API_BASE}/logs?lines=${encodeURIComponent(lines)}&search=${encodeURIComponent(search)}`);
            const data = await res.json();
            document.getElementById("log-content").innerText = (data.lines || []).join("\n");
        }

        async function suggestExemplars() {
            const query = document.getElementById("ghostSearchQuery").value.trim();
            if (!query) return;
            const container = document.getElementById("exemplarContainer");
            const list = document.getElementById("exemplarList");
            container.classList.remove("hidden");
            list.innerHTML = "<p class='text-xs text-slate-400'>Searching...</p>";
            try {
                const res = await fetch(`${API_BASE}/suggest-exemplars`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ query })
                });
                const data = await res.json();
                list.innerHTML = "";
                (data.suggestions || []).forEach((item) => {
                    const row = document.createElement("div");
                    row.className = "bg-black/30 rounded p-2 border border-white/10";
                    row.innerHTML = `
                        <p class="text-xs font-semibold">${item.title}</p>
                        <p class="text-[10px] text-slate-400 mb-1">${item.url}</p>
                        <button class="text-xs bg-white/10 rounded px-2 py-1" onclick="selectExemplar('${item.url}')">Use</button>
                    `;
                    list.appendChild(row);
                });
            } catch (error) {
                list.innerHTML = `<p class="text-xs text-rose-400">${error.message}</p>`;
            }
        }

        function selectExemplar(url) {
            document.getElementById("ghostUrl").value = url;
            extractGhost();
        }

        async function extractGhost() {
            const url = document.getElementById("ghostUrl").value.trim();
            if (!url) return;
            const status = document.getElementById("ghostStatus");
            const summary = document.getElementById("ghostSummary");
            const blueprint = document.getElementById("ghostBlueprint");
            status.classList.remove("hidden");
            summary.innerText = "Extracting...";
            blueprint.innerText = "";
            try {
                const res = await fetch(`${API_BASE}/ghost`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ url })
                });
                const data = await res.json();
                if (!data.success) throw new Error(data.detail || "Failed.");
                summary.innerText = data.summary || "Extraction complete.";
                blueprint.innerText = JSON.stringify(data.blueprint || {}, null, 2);
                window.ghostBlueprintPath = data.blueprint_path || null;
                appendLog("Ghost blueprint extracted.", "text-indigo-300");
            } catch (error) {
                summary.innerText = `Error: ${error.message}`;
            }
        }

        showSection("dashboard");
        loadSettings();
        setInterval(updateStatus, 2000);
        updateStatus();
    </script>
</body>
</html>