# Dark App Factory -- Environment Variables
# Copy to .env and adjust as needed.

# Foreman (planning, enrichment, blueprint)
FOREMAN_MODEL=llama3.1:8b
FOREMAN_BASE_URL=http://localhost:11434/v1
FOREMAN_API_KEY=ollama

# Worker (code generation)
WORKER_MODEL=qwen2.5-coder:latest
WORKER_BASE_URL=http://localhost:11434/v1
WORKER_API_KEY=ollama

# Ollama context (mandatory for large specs)
OLLAMA_CONTEXT_LENGTH=65536

# Digital Twin Universe
DTU_PORT=8001

# Generated-app port window (Judge assigns PORT / VITE_PORT from here).
# Keep clear of your own dev servers on 3000 / 5173 / 8000 / 8080.
APP_PORT_START=19300
APP_PORT_END=19400

# Boot / install for the generated app
# SKIP_APP_INSTALL=true only when node_modules and the Python env are ready.
SKIP_APP_INSTALL=false
APP_INSTALL_TIMEOUT=600

# Optional: OpenAI / Anthropic (if not using Ollama)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# FOREMAN_API_KEY=
# WORKER_API_KEY=
