# Dark App Factory -- Environment Variables
# Copy to .env and adjust as needed.

# Foreman (planning, enrichment, blueprint)
FOREMAN_MODEL=llama3.1:latest
FOREMAN_BASE_URL=http://localhost:11434/v1
FOREMAN_API_KEY=ollama

# Worker (code generation)
WORKER_MODEL=qwen2.5-coder:latest
WORKER_BASE_URL=http://localhost:11434/v1
WORKER_API_KEY=ollama

# Ollama context (mandatory for large specs)
OLLAMA_CONTEXT_LENGTH=65536

# Digital Twin Universe
DTU_PORT=8001

# Optional: OpenAI / Anthropic (if not using Ollama)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# FOREMAN_API_KEY=
# WORKER_API_KEY=
