"""FastMCP 3.1 fleet adapter: dashboard health, launch, logs, settings."""

from __future__ import annotations

import json
import os
import subprocess
from enum import Enum
from pathlib import Path
from typing import Any

import httpx
from fastmcp import FastMCP
from pydantic import Field

# mcp-server/src/dark_app_factory_mcp/server.py -> repo root is parents[3]
REPO_ROOT: Path = Path(__file__).resolve().parents[3]
LOG_FILE = REPO_ROOT / "logs" / "factory.log"
SETTINGS_FILE = REPO_ROOT / "web" / "settings.json"
WEB_START = REPO_ROOT / "web" / "start.ps1"


def _web_base() -> str:
    return os.getenv("DAF_WEB_BASE", "http://127.0.0.1:10738").rstrip("/")


class FleetOperation(str, Enum):
    """Operations for the portmanteau tool."""

    ping = "ping"
    web_health = "web_health"
    web_status = "web_status"
    dashboard_url = "dashboard_url"
    launch_dashboard = "launch_dashboard"
    tail_log = "tail_log"
    read_settings = "read_settings"


mcp = FastMCP(
    name="dark-app-factory-mcp",
    instructions=(
        "Fleet adapter for Dark App Factory. Use factory_fleet(operation=...) to check "
        "the web dashboard, launch it, or read local logs/settings. Web UI defaults to "
        "port 10738; set DAF_WEB_BASE if different."
    ),
)


@mcp.tool()
async def factory_fleet(
    operation: FleetOperation = Field(
        description="Which operation: ping, web_health, web_status, dashboard_url, launch_dashboard, tail_log, read_settings."
    ),
    lines: int = Field(
        default=80,
        ge=1,
        le=2000,
        description="For tail_log: number of lines from end of factory.log.",
    ),
    log_search: str = Field(
        default="",
        description="For tail_log: optional case-insensitive substring filter.",
    ),
) -> dict[str, Any]:
    """FACTORY_FLEET — Control and inspect Dark App Factory from the fleet.

    PORTMANTEAU PATTERN RATIONALE: One tool keeps the MCP surface small while covering
    health, launch, and diagnostics for a non-MCP web app.

    Args:
        operation: Action to perform.
        lines: Log tail line count (tail_log only).
        log_search: Filter log lines (tail_log only).

    Returns:
        Structured dict with success, message, and operation-specific fields.
    """
    base = _web_base()
    if operation == FleetOperation.ping:
        return {
            "success": True,
            "message": "dark-app-factory-mcp online",
            "repo_root": str(REPO_ROOT),
            "web_base": base,
            "mcp_adapter": "embedded mcp-server/",
        }

    if operation == FleetOperation.dashboard_url:
        return {
            "success": True,
            "message": "Dashboard URL",
            "url": f"{base}/",
            "web_base": base,
        }

    if operation == FleetOperation.web_health:
        return await _http_json(f"{base}/api/v1/health", "GET")

    if operation == FleetOperation.web_status:
        return await _http_json(f"{base}/api/status", "GET")

    if operation == FleetOperation.launch_dashboard:
        if not WEB_START.exists():
            return {
                "success": False,
                "error": "web/start.ps1 not found",
                "path": str(WEB_START),
                "error_type": "missing_script",
            }
        try:
            subprocess.Popen(
                [
                    "powershell.exe",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    str(WEB_START),
                ],
                cwd=str(REPO_ROOT),
                creationflags=subprocess.CREATE_NEW_CONSOLE,
            )
            return {
                "success": True,
                "message": "Launched web/start.ps1 in a new console.",
                "script": str(WEB_START),
            }
        except OSError as exc:
            return {
                "success": False,
                "error": str(exc),
                "error_type": "launch_failed",
            }

    if operation == FleetOperation.tail_log:
        if not LOG_FILE.exists():
            return {
                "success": False,
                "error": "Log file not found (factory not run yet?)",
                "path": str(LOG_FILE),
                "error_type": "missing_log",
            }
        text = LOG_FILE.read_text(encoding="utf-8", errors="replace").splitlines()
        if log_search.strip():
            needle = log_search.lower()
            text = [ln for ln in text if needle in ln.lower()]
        tail = text[-lines:] if lines else text
        return {
            "success": True,
            "message": f"Last {len(tail)} line(s)",
            "path": str(LOG_FILE),
            "lines": tail,
        }

    if operation == FleetOperation.read_settings:
        if not SETTINGS_FILE.exists():
            return {
                "success": True,
                "message": "No web/settings.json yet",
                "path": str(SETTINGS_FILE),
                "settings": None,
            }
        try:
            data = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            return {
                "success": False,
                "error": f"Invalid JSON: {exc}",
                "path": str(SETTINGS_FILE),
                "error_type": "invalid_json",
            }
        return {
            "success": True,
            "message": "Current dashboard LLM settings (file)",
            "path": str(SETTINGS_FILE),
            "settings": data,
        }

    return {"success": False, "error": "unhandled operation", "error_type": "internal"}


async def _http_json(url: str, method: str) -> dict[str, Any]:
    try:
        async with httpx.AsyncClient(timeout=10.0) as client:
            response = await client.request(method, url)
            payload: Any
            try:
                payload = response.json()
            except json.JSONDecodeError:
                payload = {"raw": response.text[:2000]}
            return {
                "success": response.is_success,
                "message": f"HTTP {response.status_code}",
                "url": url,
                "status_code": response.status_code,
                "body": payload,
            }
    except httpx.RequestError as exc:
        return {
            "success": False,
            "message": "Request failed — is the web dashboard running?",
            "url": url,
            "error": str(exc),
            "error_type": "http_error",
        }
