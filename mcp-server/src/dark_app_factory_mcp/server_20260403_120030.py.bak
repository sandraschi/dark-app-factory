"""Dark App Factory MCP server — fleet control + factory operations.

Tools
-----
factory_fleet   — dashboard health, log tail, settings (read-only ops)
factory_run     — start a generation run (writes vibe, spawns subprocess)
factory_status  — poll run status / progress
factory_stop    — cancel a running build
factory_launch  — start the generated app from an output directory
factory_outputs — list completed output directories
"""

from __future__ import annotations

import ast
import json
import os
import re
import signal
import subprocess
import sys
import time
import uuid
from enum import Enum
from pathlib import Path
from typing import Any, Optional

import httpx
from fastmcp import FastMCP
from fastmcp.tools import ToolResult
from prefab_ui.app import PrefabApp
from prefab_ui.components import (
    Badge,
    Card,
    CardContent,
    Column,
    DataTable,
    DataTableColumn,
    Grid,
    Heading,
    Muted,
    Row,
    Separator,
    Text,
)
from pydantic import BaseModel, ConfigDict, Field

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
REPO_ROOT: Path = Path(__file__).resolve().parents[3]
LOG_FILE = REPO_ROOT / "logs" / "factory.log"
SETTINGS_FILE = REPO_ROOT / "web" / "settings.json"
WEB_START = REPO_ROOT / "web" / "start.ps1"
OUTPUTS_DIR = REPO_ROOT / "outputs"
VIBE_FILE = REPO_ROOT / "vibe.md"
PYTHON = sys.executable  # same interpreter as the MCP server venv

# In-memory run registry  {run_id: RunRecord}
_RUNS: dict[str, dict[str, Any]] = {}


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
mcp = FastMCP(
    name="dark-app-factory-mcp",
    instructions=(
        "Control and inspect Dark App Factory. "
        "Use factory_run to start a generation, factory_status to poll progress, "
        "factory_launch to start the resulting app, factory_outputs to list past builds, "
        "and factory_fleet for dashboard/log operations."
    ),
)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
def _web_base() -> str:
    return os.getenv("DAF_WEB_BASE", "http://127.0.0.1:10738").rstrip("/")


async def _http_json(url: str, method: str = "GET") -> dict[str, Any]:
    try:
        async with httpx.AsyncClient(timeout=10.0) as client:
            response = await client.request(method, url)
            try:
                payload: Any = response.json()
            except json.JSONDecodeError:
                payload = {"raw": response.text[:2000]}
            return {
                "success": response.is_success,
                "status_code": response.status_code,
                "url": url,
                "body": payload,
            }
    except httpx.RequestError as exc:
        return {
            "success": False,
            "error": str(exc),
            "error_type": "http_error",
            "url": url,
        }


def _tail_log(lines: int = 80, search: str = "") -> list[str]:
    if not LOG_FILE.exists():
        return []
    text = LOG_FILE.read_text(encoding="utf-8", errors="replace").splitlines()
    if search.strip():
        needle = search.lower()
        text = [ln for ln in text if needle in ln.lower()]
    return text[-lines:]


def _list_outputs() -> list[dict[str, Any]]:
    """Return metadata for each output_NNN directory, newest first."""
    if not OUTPUTS_DIR.exists():
        return []
    dirs = sorted(OUTPUTS_DIR.iterdir(), reverse=True)
    results = []
    for d in dirs:
        if not d.is_dir():
            continue
        manifest_path = d / "manifest.json"
        manifest = {}
        if manifest_path.exists():
            try:
                manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
            except Exception:
                pass
        readme_path = d / "README.md"
        readme_snippet = ""
        if readme_path.exists():
            readme_snippet = readme_path.read_text(encoding="utf-8", errors="replace")[:300]
        results.append({
            "name": d.name,
            "path": str(d),
            "mtime": d.stat().st_mtime,
            "mtime_human": time.strftime(
                "%Y-%m-%d %H:%M", time.localtime(d.stat().st_mtime)
            ),
            "stack": manifest.get("stack", "unknown"),
            "project_name": manifest.get("project_name", ""),
            "file_count": manifest.get("files") and len(manifest["files"]) or None,
            "readme_snippet": readme_snippet,
        })
    return results


# ---------------------------------------------------------------------------
# Tool: factory_fleet  (read-only dashboard ops, unchanged from v1 + extras)
# ---------------------------------------------------------------------------
class FleetOp(str, Enum):
    ping = "ping"
    web_health = "web_health"
    web_status = "web_status"
    dashboard_url = "dashboard_url"
    launch_dashboard = "launch_dashboard"
    tail_log = "tail_log"
    read_settings = "read_settings"


class FleetInput(BaseModel):
    model_config = ConfigDict(extra="forbid")
    operation: FleetOp = Field(
        description="ping | web_health | web_status | dashboard_url | "
                    "launch_dashboard | tail_log | read_settings"
    )
    lines: int = Field(default=80, ge=1, le=2000, description="tail_log: lines from end")
    log_search: str = Field(default="", description="tail_log: substring filter")


@mcp.tool(
    name="factory_fleet",
    annotations={
        "title": "Dark App Factory Fleet Control",
        "readOnlyHint": False,
        "destructiveHint": False,
        "idempotentHint": True,
        "openWorldHint": True,
    },
)
async def factory_fleet(params: FleetInput) -> str:
    """Dashboard health, log tailing, settings and launch for the Dark App Factory web UI.

    Args:
        params: FleetInput with operation and optional lines/log_search.

    Returns:
        str: JSON result dict.
    """
    op = params.operation
    base = _web_base()

    if op == FleetOp.ping:
        return json.dumps({
            "success": True,
            "message": "dark-app-factory-mcp online",
            "repo_root": str(REPO_ROOT),
            "web_base": base,
        })

    if op == FleetOp.dashboard_url:
        return json.dumps({"success": True, "url": f"{base}/"})

    if op == FleetOp.web_health:
        return json.dumps(await _http_json(f"{base}/api/v1/health"))

    if op == FleetOp.web_status:
        return json.dumps(await _http_json(f"{base}/api/status"))

    if op == FleetOp.launch_dashboard:
        if not WEB_START.exists():
            return json.dumps({"success": False, "error": "web/start.ps1 not found"})
        try:
            subprocess.Popen(
                ["powershell.exe", "-ExecutionPolicy", "Bypass", "-File", str(WEB_START)],
                cwd=str(REPO_ROOT),
                creationflags=subprocess.CREATE_NEW_CONSOLE,
            )
            return json.dumps({"success": True, "message": "Dashboard launched."})
        except OSError as exc:
            return json.dumps({"success": False, "error": str(exc)})

    if op == FleetOp.tail_log:
        if not LOG_FILE.exists():
            return json.dumps({"success": False, "error": "Log file not found."})
        tail = _tail_log(params.lines, params.log_search)
        return json.dumps({"success": True, "lines": tail, "count": len(tail)})

    if op == FleetOp.read_settings:
        if not SETTINGS_FILE.exists():
            return json.dumps({"success": True, "settings": None})
        try:
            data = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
            return json.dumps({"success": True, "settings": data})
        except json.JSONDecodeError as exc:
            return json.dumps({"success": False, "error": str(exc)})

    return json.dumps({"success": False, "error": "unhandled operation"})


# ---------------------------------------------------------------------------
# Tool: factory_run  — start a generation
# ---------------------------------------------------------------------------
class RunInput(BaseModel):
    model_config = ConfigDict(extra="forbid")
    vibe: str = Field(
        ...,
        min_length=10,
        max_length=8000,
        description=(
            "The vibe / prompt for what to build. Plain natural language. "
            "Example: 'A dentist booking app for Dr Painlessdriller in Hollabrunn. "
            "Austrian standards, dark theme, patients can book online.' "
            "Can include a ## Tech Stack section to override defaults."
        ),
    )
    output_name: Optional[str] = Field(
        default=None,
        description="Optional output directory name under outputs/. "
                    "E.g. 'dentist_app'. Auto-generated if omitted.",
    )
    foreman_model: Optional[str] = Field(
        default=None,
        description="Ollama model for the foreman (planning). Defaults to env/config.",
    )
    worker_model: Optional[str] = Field(
        default=None,
        description="Ollama model for the worker (code generation). Defaults to env/config.",
    )


@mcp.tool(
    name="factory_run",
    annotations={
        "title": "Start a Dark App Factory generation run",
        "readOnlyHint": False,
        "destructiveHint": False,
        "idempotentHint": False,
        "openWorldHint": False,
    },
)
async def factory_run(params: RunInput) -> str:
    """Start a full factory generation run from a vibe/prompt.

    Writes the vibe to a temp file, spawns `python factory.py run` as a
    background subprocess, and returns a run_id for polling with factory_status.

    Args:
        params: RunInput — vibe text, optional output name and model overrides.

    Returns:
        str: JSON with run_id, output_dir, status="started".
    """
    run_id = str(uuid.uuid4())[:8]

    # Write vibe to an isolated work dir so it doesn't overwrite vibe.md
    work_dir = REPO_ROOT / "outputs" / f"_run_{run_id}"
    work_dir.mkdir(parents=True, exist_ok=True)
    vibe_path = work_dir / "vibe.md"
    vibe_path.write_text(params.vibe, encoding="utf-8")

    # Determine output dir
    if params.output_name:
        output_dir = str(OUTPUTS_DIR / params.output_name)
    else:
        # Find next available output_NNN
        i = 1
        while (OUTPUTS_DIR / f"output_{i:03d}").exists():
            i += 1
        output_dir = str(OUTPUTS_DIR / f"output_{i:03d}")

    # Build command
    cmd = [
        PYTHON, "-c",
        (
            "import asyncio, sys; sys.path.insert(0, r'{repo}'); "
            "from factory import main_flow; "
            "asyncio.run(main_flow("
            "vibe_path=r'{vibe}', "
            "output_dir=r'{out}', "
            "work_dir=r'{work}'"
            "{foreman}"
            "{worker}"
            "))"
        ).format(
            repo=str(REPO_ROOT),
            vibe=str(vibe_path),
            out=output_dir,
            work=str(work_dir),
            foreman=f", foreman_model='{params.foreman_model}'" if params.foreman_model else "",
            worker=f", worker_model='{params.worker_model}'" if params.worker_model else "",
        ),
    ]

    log_path = work_dir / "run.log"

    try:
        with open(log_path, "w", encoding="utf-8") as log_fh:
            proc = subprocess.Popen(
                cmd,
                cwd=str(REPO_ROOT),
                stdout=log_fh,
                stderr=subprocess.STDOUT,
                # Don't inherit the MCP server's stdio
                stdin=subprocess.DEVNULL,
            )
    except Exception as exc:
        return json.dumps({"success": False, "error": str(exc), "run_id": run_id})

    _RUNS[run_id] = {
        "run_id": run_id,
        "pid": proc.pid,
        "proc": proc,
        "output_dir": output_dir,
        "work_dir": str(work_dir),
        "log_path": str(log_path),
        "vibe_snippet": params.vibe[:200],
        "started_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        "status": "running",
    }

    return json.dumps({
        "success": True,
        "run_id": run_id,
        "pid": proc.pid,
        "output_dir": output_dir,
        "log_path": str(log_path),
        "status": "started",
        "message": f"Generation started. Poll with factory_status(run_id='{run_id}').",
    })


# ---------------------------------------------------------------------------
# Tool: factory_status  — poll a run
# ---------------------------------------------------------------------------
class StatusInput(BaseModel):
    model_config = ConfigDict(extra="forbid")
    run_id: Optional[str] = Field(
        default=None,
        description="run_id from factory_run. Omit to list all known runs.",
    )
    log_tail: int = Field(
        default=30,
        ge=0,
        le=500,
        description="Number of recent log lines to include. 0 = no log.",
    )


@mcp.tool(
    name="factory_status",
    annotations={
        "title": "Poll Dark App Factory run status",
        "readOnlyHint": True,
        "destructiveHint": False,
        "idempotentHint": True,
        "openWorldHint": False,
    },
)
async def factory_status(params: StatusInput) -> str:
    """Poll the status of a factory_run or list all runs.

    Args:
        params: StatusInput — optional run_id and log_tail line count.

    Returns:
        str: JSON with status (running | completed | failed), exit_code,
             output_dir, log tail, and file count when completed.
    """
    if not params.run_id:
        # List all runs summary
        summary = []
        for rec in _RUNS.values():
            proc: subprocess.Popen = rec["proc"]
            code = proc.poll()
            summary.append({
                "run_id": rec["run_id"],
                "status": "running" if code is None else ("completed" if code == 0 else "failed"),
                "exit_code": code,
                "started_at": rec["started_at"],
                "output_dir": rec["output_dir"],
                "vibe_snippet": rec["vibe_snippet"],
            })
        return json.dumps({"success": True, "runs": summary})

    run_id = params.run_id
    if run_id not in _RUNS:
        return json.dumps({
            "success": False,
            "error": f"Unknown run_id '{run_id}'. Use factory_status() with no run_id to list all.",
        })

    rec = _RUNS[run_id]
    proc: subprocess.Popen = rec["proc"]
    exit_code = proc.poll()

    if exit_code is None:
        status = "running"
    elif exit_code == 0:
        status = "completed"
        rec["status"] = "completed"
    else:
        status = "failed"
        rec["status"] = "failed"

    result: dict[str, Any] = {
        "success": True,
        "run_id": run_id,
        "status": status,
        "exit_code": exit_code,
        "pid": rec["pid"],
        "started_at": rec["started_at"],
        "output_dir": rec["output_dir"],
    }

    # File count if completed
    output_path = Path(rec["output_dir"])
    if status == "completed" and output_path.exists():
        file_count = sum(1 for _ in output_path.rglob("*") if _.is_file())
        result["file_count"] = file_count
        result["message"] = (
            f"Build complete. {file_count} files in {rec['output_dir']}. "
            f"Launch with factory_launch(output_dir='{rec['output_dir']}')."
        )

    # Log tail
    if params.log_tail > 0:
        log_path = Path(rec["log_path"])
        if log_path.exists():
            lines = log_path.read_text(encoding="utf-8", errors="replace").splitlines()
            result["log_tail"] = lines[-params.log_tail:]
        else:
            result["log_tail"] = []

    return json.dumps(result)


# ---------------------------------------------------------------------------
# Tool: factory_stop  — cancel a run
# ---------------------------------------------------------------------------
class StopInput(BaseModel):
    model_config = ConfigDict(extra="forbid")
    run_id: str = Field(..., description="run_id to cancel.")


@mcp.tool(
    name="factory_stop",
    annotations={
        "title": "Stop a running Dark App Factory build",
        "readOnlyHint": False,
        "destructiveHint": True,
        "idempotentHint": False,
        "openWorldHint": False,
    },
)
async def factory_stop(params: StopInput) -> str:
    """Cancel a running factory build by run_id.

    Args:
        params: StopInput — run_id to cancel.

    Returns:
        str: JSON confirming termination or error.
    """
    if params.run_id not in _RUNS:
        return json.dumps({"success": False, "error": f"Unknown run_id '{params.run_id}'."})

    rec = _RUNS[params.run_id]
    proc: subprocess.Popen = rec["proc"]

    if proc.poll() is not None:
        return json.dumps({
            "success": False,
            "error": "Process already finished.",
            "exit_code": proc.returncode,
        })

    try:
        if sys.platform == "win32":
            proc.terminate()
        else:
            os.kill(proc.pid, signal.SIGTERM)
        rec["status"] = "stopped"
        return json.dumps({
            "success": True,
            "message": f"Run {params.run_id} (PID {rec['pid']}) terminated.",
        })
    except Exception as exc:
        return json.dumps({"success": False, "error": str(exc)})


# ---------------------------------------------------------------------------
# Tool: factory_launch  — start the generated app
# ---------------------------------------------------------------------------
class LaunchInput(BaseModel):
    model_config = ConfigDict(extra="forbid")
    output_dir: Optional[str] = Field(
        default=None,
        description="Absolute path to the generated app directory. "
                    "Omit to launch the most recent output.",
    )
    port: Optional[int] = Field(
        default=None,
        ge=1024,
        le=65535,
        description="Override the PORT env var. Default: 3000 (Node) / 8000 (Python).",
    )


@mcp.tool(
    name="factory_launch",
    annotations={
        "title": "Launch a generated app from an output directory",
        "readOnlyHint": False,
        "destructiveHint": False,
        "idempotentHint": False,
        "openWorldHint": False,
    },
)
async def factory_launch(params: LaunchInput) -> str:
    """Launch the generated app by running npm run dev or python main.py.

    Detects the stack from manifest.json or file presence.
    Opens in a new console window on Windows.

    Args:
        params: LaunchInput — optional output_dir and port override.

    Returns:
        str: JSON with launched commands, ports, and URLs.
    """
    # Resolve output dir
    if params.output_dir:
        target = Path(params.output_dir)
    else:
        outputs = _list_outputs()
        if not outputs:
            return json.dumps({"success": False, "error": "No output directories found."})
        target = Path(outputs[0]["path"])

    if not target.exists():
        return json.dumps({"success": False, "error": f"Directory not found: {target}"})

    # Detect stack
    has_package_json = (target / "package.json").exists()
    has_server_js = (target / "server.js").exists()
    has_main_py = (target / "main.py").exists()
    has_requirements = (target / "requirements.txt").exists()
    is_python = has_main_py or has_requirements
    is_node = has_package_json or has_server_js

    if not is_python and not is_node:
        return json.dumps({
            "success": False,
            "error": "Cannot detect stack — no package.json, server.js, main.py, or requirements.txt found.",
            "dir": str(target),
        })

    env = os.environ.copy()
    launched = []

    if is_python:
        backend_port = params.port or 8000
        env["PORT"] = str(backend_port)
        entry = "main.py" if has_main_py else "app.py"
        cmd_backend = f"pip install -r requirements.txt & python {entry}"
        if sys.platform == "win32":
            subprocess.Popen(
                ["cmd", "/k", cmd_backend],
                cwd=str(target),
                env=env,
                creationflags=subprocess.CREATE_NEW_CONSOLE,
            )
        else:
            subprocess.Popen(["bash", "-c", cmd_backend], cwd=str(target), env=env)
        launched.append({"type": "backend", "cmd": cmd_backend, "port": backend_port})

        if has_package_json:
            # Hybrid: also launch React frontend
            vite_port = (params.port or 5173) + (1 if params.port else 0)
            env2 = env.copy()
            env2["VITE_PORT"] = str(vite_port)
            cmd_fe = "npm.cmd install --legacy-peer-deps & npm.cmd run dev" if sys.platform == "win32" else "npm install --legacy-peer-deps && npm run dev"
            if sys.platform == "win32":
                subprocess.Popen(
                    ["cmd", "/k", cmd_fe],
                    cwd=str(target),
                    env=env2,
                    creationflags=subprocess.CREATE_NEW_CONSOLE,
                )
            else:
                subprocess.Popen(["bash", "-c", cmd_fe], cwd=str(target), env=env2)
            launched.append({"type": "frontend", "cmd": cmd_fe, "port": vite_port})

    elif is_node:
        server_port = params.port or 3000
        vite_port = server_port + 1
        env["PORT"] = str(server_port)
        env["VITE_PORT"] = str(vite_port)
        cmd = "npm.cmd install --legacy-peer-deps & npm.cmd run dev" if sys.platform == "win32" else "npm install --legacy-peer-deps && npm run dev"
        if sys.platform == "win32":
            subprocess.Popen(
                ["cmd", "/k", cmd],
                cwd=str(target),
                env=env,
                creationflags=subprocess.CREATE_NEW_CONSOLE,
            )
        else:
            subprocess.Popen(["bash", "-c", cmd], cwd=str(target), env=env)
        launched.append({"type": "fullstack", "cmd": cmd, "backend_port": server_port, "frontend_port": vite_port})

    urls = []
    for item in launched:
        if "port" in item:
            urls.append(f"http://localhost:{item['port']}")
        if "frontend_port" in item:
            urls.append(f"http://localhost:{item['frontend_port']} (frontend)")
        if "backend_port" in item:
            urls.append(f"http://localhost:{item['backend_port']} (backend)")

    return json.dumps({
        "success": True,
        "message": "App launched in new console(s). Allow ~10s for startup.",
        "output_dir": str(target),
        "launched": launched,
        "urls": urls,
    })


# ---------------------------------------------------------------------------
# Tool: factory_assess  — analyse a generated output, render card + push to webapp
# ---------------------------------------------------------------------------
class AssessInput(BaseModel):
    model_config = ConfigDict(extra="forbid")
    output_dir: Optional[str] = Field(
        default=None,
        description="Absolute path or name (e.g. 'output_008') of the output to assess. "
                    "Omit to assess the most recent output.",
    )
    push_to_webapp: bool = Field(
        default=True,
        description="POST the result to the web dashboard at DAF_WEB_BASE/api/assess.",
    )


@mcp.tool(
    name="factory_assess",
    annotations={
        "title": "Assess a Dark App Factory generated output",
        "readOnlyHint": True,
        "destructiveHint": False,
        "idempotentHint": True,
        "openWorldHint": False,
    },
)
async def factory_assess(params: AssessInput) -> str:
    """Analyse a generated app output directory and return a detailed assessment card.

    Performs static analysis (no LLM): file counts by language, entry point
    detection, missing critical files, JS syntax errors via node --check,
    package.json validation, framer-motion import check, runt file detection,
    tree-character filename detection. Computes a structure score and letter grade.

    Posts the result JSON to the web dashboard (/api/assess) if push_to_webapp=True
    and the dashboard is reachable.

    Returns:
        str: A rich Markdown assessment card plus the raw JSON payload.

    Schema of returned JSON (also posted to dashboard):
        output_dir, project_name, stack, generated_at, file_stats (dict),
        language_breakdown (dict of ext->count), structure_score (0-100),
        completeness_issues (list[str]), syntax_errors (list[str]),
        strengths (list[str]), grade (A/B/C/D/F), summary (str)
    """
    import ast
    import json as _json
    import re
    import subprocess as _sp
    import time as _time
    from pathlib import Path as P

    # -----------------------------------------------------------------------
    # 1. Resolve target directory
    # -----------------------------------------------------------------------
    if params.output_dir:
        target = P(params.output_dir)
        if not target.is_absolute():
            target = OUTPUTS_DIR / params.output_dir
    else:
        outputs = _list_outputs()
        if not outputs:
            return _json.dumps({"success": False, "error": "No output directories found."})
        target = P(outputs[0]["path"])

    if not target.exists():
        return _json.dumps({"success": False, "error": f"Directory not found: {target}"})

    # -----------------------------------------------------------------------
    # 2. Load manifest
    # -----------------------------------------------------------------------
    manifest: dict = {}
    manifest_path = target / "manifest.json"
    if manifest_path.exists():
        try:
            manifest = _json.loads(manifest_path.read_text(encoding="utf-8"))
        except Exception:
            pass

    project_name = manifest.get("project_name", target.name)
    stack = manifest.get("stack", "unknown")

    # -----------------------------------------------------------------------
    # 3. Walk files
    # -----------------------------------------------------------------------
    SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", "venv"}
    SKIP_EXTENSIONS = {".pyc", ".pyo", ".map"}
    RUNT_THRESHOLDS = {".tsx": 500, ".jsx": 500, ".py": 400, ".js": 300}
    TREE_CHARS = {"│", "├", "└", "─"}

    all_files: list[P] = []
    for f in target.rglob("*"):
        if f.is_file():
            if any(part in SKIP_DIRS for part in f.parts):
                continue
            if f.suffix in SKIP_EXTENSIONS:
                continue
            all_files.append(f)

    total_files = len(all_files)
    total_size = sum(f.stat().st_size for f in all_files)

    # Language breakdown
    lang_counts: dict[str, int] = {}
    for f in all_files:
        ext = f.suffix.lower() or "(no ext)"
        lang_counts[ext] = lang_counts.get(ext, 0) + 1
    lang_counts = dict(sorted(lang_counts.items(), key=lambda x: -x[1]))

    # -----------------------------------------------------------------------
    # 4. Specific checks
    # -----------------------------------------------------------------------
    issues: list[str] = []
    strengths: list[str] = []
    syntax_errors: list[str] = []

    # ---- Entry points ----
    has_server_js = (target / "server.js").exists()
    has_main_py = (target / "main.py").exists()
    has_app_py = (target / "app.py").exists()
    has_package_json = (target / "package.json").exists()
    has_requirements = (target / "requirements.txt").exists()
    has_vite_config = (target / "vite.config.ts").exists()
    has_index_html = (target / "index.html").exists()
    has_app_tsx = (target / "src" / "App.tsx").exists()
    has_readme = (target / "README.md").exists()
    has_manifest = manifest_path.exists()
    has_git = (target / ".git").exists()
    has_demos = (target / "demos").exists()
    has_www = (target / "www" / "index.html").exists()

    is_node = has_package_json or has_server_js
    is_python = has_main_py or has_app_py or has_requirements

    if not (is_node or is_python):
        issues.append("CRITICAL: No recognisable entry point (no server.js, main.py, package.json)")
    else:
        if is_node and not has_server_js:
            issues.append("package.json present but server.js missing — app won't start")
        if is_node and has_server_js:
            strengths.append("server.js present")
        if is_python and not has_main_py and not has_app_py:
            issues.append("requirements.txt present but no main.py or app.py")
        if is_python and (has_main_py or has_app_py):
            strengths.append(f"Python entry point present ({'main.py' if has_main_py else 'app.py'})")

    if is_node and has_package_json:
        try:
            pkg = _json.loads((target / "package.json").read_text(encoding="utf-8"))
            scripts = pkg.get("scripts", {})
            if "dev" not in scripts:
                issues.append("package.json missing 'dev' script — npm run dev won't work")
            else:
                strengths.append("npm run dev script present")
            # Kitchen-sink deps check
            all_deps = {**pkg.get("dependencies", {}), **pkg.get("devDependencies", {})}
            bloat = [d for d in all_deps if d in {
                "three", "@react-three/fiber", "langchain", "@langchain/core",
                "@pinecone-database/pinecone", "midi-writer-js", "wavesurfer.js",
                "video.js", "tone", "howler", "moment",
            }]
            if bloat:
                issues.append(f"Kitchen-sink deps that may not be needed: {', '.join(bloat)}")
        except Exception:
            issues.append("package.json is not valid JSON")

    if not has_readme:
        issues.append("README.md missing")
    else:
        readme_size = (target / "README.md").stat().st_size
        if readme_size < 500:
            issues.append(f"README.md is a stub ({readme_size} bytes)")
        else:
            strengths.append("README.md present and non-trivial")

    if has_vite_config:
        strengths.append("vite.config.ts present")
    elif is_node and has_package_json:
        issues.append("vite.config.ts missing — frontend won't start")

    if has_git:
        strengths.append("Git repo initialised")
    else:
        issues.append("No .git directory — not version-controlled")

    if has_manifest:
        strengths.append("manifest.json present")

    if has_demos:
        strengths.append("demos/ directory present (showboat artifacts)")

    if has_www:
        strengths.append("www/index.html (landing page) present")

    # ---- App.tsx framer-motion check ----
    if has_app_tsx:
        app_tsx = (target / "src" / "App.tsx").read_text(encoding="utf-8", errors="replace")
        if "import FramerMotion from" in app_tsx:
            issues.append("src/App.tsx uses default framer-motion import (will crash)")
        elif "exitBeforeEnter" in app_tsx:
            issues.append("src/App.tsx uses deprecated exitBeforeEnter prop")
        else:
            strengths.append("src/App.tsx framer-motion import is correct")

        # Missing page imports
        imported_pages = re.findall(
            r"from\s+['\"](?:\./)?(pages|components)/([^'\"]+)['\"]", app_tsx
        )
        for _, component in imported_pages:
            component = component.replace(".tsx", "").replace(".jsx", "")
            for folder in ["pages", "components"]:
                fpath = target / "src" / folder / f"{component}.tsx"
                if not fpath.exists():
                    issues.append(f"src/App.tsx imports {component} but src/{folder}/{component}.tsx missing")
                    break

    # ---- Tree-character filenames ----
    tree_filenames = [
        str(f.relative_to(target)) for f in all_files
        if any(c in str(f.name) for c in TREE_CHARS)
    ]
    if tree_filenames:
        issues.append(
            f"Tree-character filenames detected ({len(tree_filenames)}): "
            + ", ".join(tree_filenames[:5])
            + (" ..." if len(tree_filenames) > 5 else "")
        )

    # ---- Runt files ----
    runts = []
    for f in all_files:
        thresh = RUNT_THRESHOLDS.get(f.suffix.lower())
        if thresh and f.stat().st_size < thresh:
            runts.append(f"{f.relative_to(target)} ({f.stat().st_size}B)")
    if runts:
        issues.append(f"Runt files (likely stubs): {', '.join(runts[:6])}")
    else:
        strengths.append("No runt/stub files detected")

    # ---- JS syntax check via node --check ----
    js_files = [f for f in all_files if f.suffix == ".js" and not f.name.endswith(".min.js")]
    for jf in js_files[:20]:  # cap to avoid slow checks
        try:
            result = _sp.run(
                ["node", "--check", str(jf)],
                capture_output=True, text=True, timeout=10
            )
            if result.returncode != 0:
                err = (result.stderr or result.stdout).strip().splitlines()
                syntax_errors.append(f"{jf.relative_to(target)}: {err[0][:120]}")
        except Exception:
            pass

    if not syntax_errors and js_files:
        strengths.append(f"No JS syntax errors in {len(js_files)} .js files")

    # ---- Python syntax check ----
    py_files = [f for f in all_files if f.suffix == ".py"]
    for pf in py_files[:20]:
        try:
            source = pf.read_text(encoding="utf-8", errors="replace")
            ast.parse(source)
        except SyntaxError as e:
            syntax_errors.append(f"{pf.relative_to(target)}: SyntaxError line {e.lineno}: {e.msg}")
    if not syntax_errors and py_files:
        strengths.append(f"No Python syntax errors in {len(py_files)} .py files")

    # -----------------------------------------------------------------------
    # 5. Score + grade
    # -----------------------------------------------------------------------
    score = 100
    critical_deductions = {
        "CRITICAL": 40,
        "won't start": 25,
        "won't work": 20,
        "missing": 10,
        "not valid JSON": 15,
        "stub": 8,
        "Runt": 10,
        "Tree-character": 15,
        "crash": 20,
        "SyntaxError": 15,
        "syntax": 12,
        "Kitchen-sink": 5,
        "deprecated": 8,
    }
    for issue in issues:
        for keyword, penalty in critical_deductions.items():
            if keyword.lower() in issue.lower():
                score -= penalty
                break
    for err in syntax_errors:
        score -= 8
    score = max(0, min(100, score))

    if score >= 85:
        grade = "A"
    elif score >= 70:
        grade = "B"
    elif score >= 55:
        grade = "C"
    elif score >= 40:
        grade = "D"
    else:
        grade = "F"

    # -----------------------------------------------------------------------
    # 6. Summary
    # -----------------------------------------------------------------------
    summary = (
        f"{project_name} — {stack}. "
        f"{total_files} files, {total_size // 1024}KB. "
        f"{len(issues)} issues, {len(syntax_errors)} syntax errors. "
        f"Grade: {grade} ({score}/100)."
    )

    # -----------------------------------------------------------------------
    # 7. Build payload
    # -----------------------------------------------------------------------
    payload = {
        "output_dir": str(target),
        "project_name": project_name,
        "stack": stack,
        "generated_at": _time.strftime("%Y-%m-%d %H:%M:%S"),
        "file_stats": {
            "total_files": total_files,
            "total_size_kb": total_size // 1024,
            "js_files": len(js_files),
            "py_files": len(py_files),
            "tsx_files": lang_counts.get(".tsx", 0),
            "md_files": lang_counts.get(".md", 0),
        },
        "language_breakdown": lang_counts,
        "structure_score": score,
        "completeness_issues": issues,
        "syntax_errors": syntax_errors,
        "strengths": strengths,
        "grade": grade,
        "summary": summary,
    }

    # -----------------------------------------------------------------------
    # 8. Push to webapp
    # -----------------------------------------------------------------------
    push_status = "not attempted"
    if params.push_to_webapp:
        try:
            async with httpx.AsyncClient(timeout=5.0) as client:
                r = await client.post(
                    f"{_web_base()}/api/assess",
                    json=payload,
                )
                push_status = f"posted to dashboard (HTTP {r.status_code})" if r.is_success else f"dashboard rejected: {r.status_code}"
        except httpx.RequestError as exc:
            push_status = f"dashboard unreachable: {exc}"

    # -----------------------------------------------------------------------
    # 9. Render Markdown card
    # -----------------------------------------------------------------------
    grade_emoji = {"A": "🟢", "B": "🟡", "C": "🟠", "D": "🔴", "F": "💀"}.get(grade, "❓")

    issue_lines = "\n".join(f"  - {i}" for i in issues) if issues else "  - None"
    syntax_lines = "\n".join(f"  - {e}" for e in syntax_errors[:10]) if syntax_errors else "  - None"
    strength_lines = "\n".join(f"  - {s}" for s in strengths) if strengths else "  - None"

    top_langs = "\n".join(
        f"  - `{ext}`: {count}" for ext, count in list(lang_counts.items())[:8]
    )

    card = f"""## {grade_emoji} Assessment: {project_name}

**Directory:** `{target}`
**Stack:** {stack}
**Grade:** {grade} ({score}/100) | **Files:** {total_files} | **Size:** {total_size // 1024} KB

### Language Breakdown
{top_langs}

### Strengths
{strength_lines}

### Issues
{issue_lines}

### Syntax Errors
{syntax_lines}

### Summary
{summary}

*Dashboard push: {push_status}*
"""

    return card + "\n---\n```json\n" + _json.dumps(payload, indent=2) + "\n```"



class OutputsInput(BaseModel):
    model_config = ConfigDict(extra="forbid")
    limit: int = Field(default=10, ge=1, le=50, description="Max results to return.")


@mcp.tool(
    name="factory_outputs",
    annotations={
        "title": "List Dark App Factory output directories",
        "readOnlyHint": True,
        "destructiveHint": False,
        "idempotentHint": True,
        "openWorldHint": False,
    },
)
async def factory_outputs(params: OutputsInput) -> str:
    """List completed generation outputs, newest first.

    Shows project name, stack, file count, build time, and README snippet.

    Args:
        params: OutputsInput — limit (default 10).

    Returns:
        str: JSON list of output metadata dicts.
    """
    outputs = _list_outputs()[: params.limit]
    return json.dumps({
        "success": True,
        "count": len(outputs),
        "outputs": outputs,
    })
