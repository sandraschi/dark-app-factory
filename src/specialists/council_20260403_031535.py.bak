        super().__init__(
            name="Houdini",
            owned_patterns=[
                "src/animations/*",
                "src/components/visualizers/*",
                "src/hooks/useAnimation.ts",
            ],
            requires=["Sculptor"],
            temperature=0.45,
        )

    async def generate(
        self, file_path: str, specs: str, shared_context: Dict[str, Any], worker: Any
    ) -> str:
        dep_context = self.get_dependency_context(shared_context)
